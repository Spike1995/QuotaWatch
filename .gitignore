# -*- mode: gitignore; -*-

# ---- Dart / Flutter ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.fvm/

# ---- IDE ----
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Env / secrets (重要！API key 永远不要 commit) ----
.env
.env.*
!.env.example
.env.local
**/auth.json
*.key
*.pem
*.p12
secrets.json
secrets/

# ---- Python (后端阶段会用到) ----
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
*.egg-info/
